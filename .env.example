PORT=4000
MONGODB_URI=mongodb://localhost:27017/doctorapp
JWT_SECRET=your-secret-key-min-32-chars

# Admin: use either plain password (not recommended) or bcrypt hash
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
# Optional: set ADMIN_PASSWORD_HASH (bcrypt hash) instead of ADMIN_PASSWORD for better security
# Generate with: node -e "const bcrypt=require('bcrypt'); bcrypt.hash('your-password',10).then(h=>console.log(h))"
# ADMIN_PASSWORD_HASH=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS: comma-separated origins (defaults to localhost:5173,5174 if not set)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
